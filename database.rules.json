{
  "rules": {
    ".read": false,
    ".write": false,

    "funfarm_apresentacao": {
      "canais": {
        "$canal": {
          ".read": "auth != null",

          "estado": {
            ".write": "auth != null",

            "slideAtual": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 50"
            },

            "totalSlides": {
              ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 50"
            },

            "atualizadoEm": {
              ".validate": "newData.isNumber()"
            },

            "apresentacaoAtiva": {
              ".validate": "newData.isBoolean()"
            },

            "$outros": {
              ".validate": false
            }
          }
        }
      }
    }
  }
}